# Proveedor de modelo a usar por los agentes.
# Formato aceptado por langchain.chat_models.init_chat_model
# Por defecto usamos Gemini (tiene tier gratuito): "google_genai:gemini-3.6-flash"
# Otras opciones: "anthropic:claude-sonnet-5", "openai:gpt-4o-mini"
MODEL_PROVIDER=google_genai:gemini-3.6-flash

# API key de Google AI Studio (https://aistudio.google.com/apikey) - tier gratuito
GOOGLE_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Comando usado por el cliente MCP para levantar el servidor de herramientas.
# Se deja vacio a proposito: por defecto el codigo usa sys.executable (el
# mismo interprete que corre la CLI), lo cual evita problemas en Windows
# donde "python" puede resolver al stub de la Microsoft Store.
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=-m src.mcp_server.server
